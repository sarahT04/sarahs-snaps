---
import "@/styles/lightbox.css"
import Layout from "./layout.astro";
import { getCollection } from "astro:content";
import { getPhotosByCity, groupPhotosByLocation } from "@/lib/photos";
import { getCountryFlag } from "@/lib/photos";
import { getLocationFromSlug } from "@/lib/slug";
import { Button } from "@/components/ui/button";
import { CircleX, ArrowLeft, ArrowRight, ZoomIn } from "lucide-react";

export async function getStaticPaths() {
  const photos = await getCollection("photos");
  const locations = groupPhotosByLocation(photos);

  // Generate both city-only and country/city paths for flexibility
  const paths = locations.flatMap((loc) => [
    { params: { city: loc.city } },
    { params: { city: `${loc.country}/${loc.city}` } }, 
  ]);

  return paths;
}

const raw = Astro.params.city || "";
const segments = raw.split("/").filter(Boolean);
// Support both "/rome" and "/italy/rome" style routes
const city = segments.at(-1) ?? "";
const country = segments.length > 1 ? segments[0] : undefined;

// Fetch photos for this location
const photos = await getPhotosByCity(city, country);

// Derive country when not present in the route, then build metadata (including flag)
const derivedCountry =
  country ??
  (photos[0] ? getLocationFromSlug(photos[0].slug).country : undefined);
const flagUrl = derivedCountry ? getCountryFlag(derivedCountry) : null;
const metadata = { country: derivedCountry, flag: flagUrl };
const prettyCity = city
  .split("-")
  .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
  .join(" ");
const prettyCountry = derivedCountry
  ? derivedCountry
      .split("-")
      .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
      .join(" ")
  : undefined;
const locationLabel = prettyCountry ? `${prettyCity}, ${prettyCountry}` : prettyCity;

function formatDate(dateStr: string) {
  try {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "2-digit",
    });
  } catch {
    return dateStr;
  }
}

function excerptFromEntry(entry: any) {
  const raw = (entry?.body ?? "").trim();
  if (!raw) return "";
  const withoutComments = raw.replace(/<!--.*?-->/gs, "");
  const oneLine = withoutComments.replace(/\n+/g, " ");
  const clean = oneLine.replace(/\s+/g, " ").trim();
  const slice = clean.slice(0, 140);
  return slice + (clean.length > 140 ? "…" : "");
}

const lightboxManifest = photos.map((entry, index) => {
  const width = entry.data.image.width;
  const height = entry.data.image.height;
  const aspectRatio = width && height ? `${width} / ${height}` : null;
  let orientation: "portrait" | "landscape" | "square" = "landscape";

  if (width && height) {
    if (width === height) {
      orientation = "square";
    } else {
      orientation = width > height ? "landscape" : "portrait";
    }
  }

  return {
    index,
    id: entry.data.id,
    src: entry.data.image.src,
    width,
    height,
    orientation,
    aspectRatio,
    title: entry.data.title,
    tags: entry.data.tags ?? [],
    date: entry.data.date,
    formattedDate: formatDate(entry.data.date),
    excerpt: excerptFromEntry(entry),
    slug: entry.slug,
    location: locationLabel,
  };
});
---

<Layout title={locationLabel}>
  <body>
    <main class="max-w-6xl mx-auto p-6">
      <!-- HEADER: FLAG + COUNTRY + PHOTOS LIST -->
      <header class="mb-6 flex gap-1">
        {
          metadata.flag && (
            <img
              src={metadata.flag}
              alt={`${prettyCountry ?? prettyCity} flag`}
              class="h-12 w-auto inline-block mr-2 rounded-xs"
              loading="lazy"
            />
          )
        }
        <div>
          <h1 class="text-2xl font-semibold text-left leading-none">
            {prettyCity}{prettyCountry ? `, ${prettyCountry}` : ""}
          </h1>
          <p class="text-muted-foreground">
            {photos.length}
            {photos.length === 1 ? "photo" : "photos"}
          </p>
        </div>
      </header>
      <!-- GALLERY -->
      {
        photos.length === 0 ? (
          <p class="text-center">No photos found for this location.</p>
        ) : (
          <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
            {photos.map((p, i) => (
              <figure
                class="group relative rounded-lg overflow-hidden border cursor-zoom-in
                aspect-square focus-visible:outline-2 focus-visible:outline-offset-2 
                focus-visible:outline-primary"
                data-photo-idx={i}
                tabindex="0"
                role="button"
                aria-label={`View ${p.data.title} in full size`}
                aria-haspopup="dialog"
              >
                <img
                  src={p.data.image.src}
                  width={p.data.image.width}
                  height={p.data.image.height}
                  alt={p.data.title}
                  class="w-full h-full block object-cover"
                  loading="lazy"
                />
                {/* on hover will show picture details */}
                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                  <div class="absolute bottom-0 left-0 right-0 p-4 text-primary-foreground">
                    <h3 class="text-sm font-semibold">{p.data.title}</h3>
                    {excerptFromEntry(p) && (
                      <p class="text-xs mt-1">{excerptFromEntry(p)}</p>
                    )}
                    <div class="flex flex-wrap gap-2 mt-2">
                      {p.data.tags.map((tag: string) => (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-primary text-primary-foreground">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <div class="text-xs mt-2 opacity-80">
                      {formatDate(p.data.date)}
                    </div>
                  </div>
                </div>
              </figure>
            ))}
          </section>
        )
      }
    </main>
    {photos.length > 0 && (
      <>
        <section
          class="lightbox"
          data-lightbox
          data-open="false"
          aria-hidden="true"
          aria-label={`Expanded photo viewer for ${locationLabel}`}
          aria-modal="true"
          role="dialog"
        >
          <div class="lightbox__backdrop" data-lightbox-backdrop aria-hidden="true"></div>
          <div class="lightbox__chrome">
            <div class="lightbox__chrome-group">              
              <Button
                type="button"
                variant="outline"
                className="lightbox__chrome-btn rounded-full bg-foreground text-primary-foreground"
                data-lightbox-close
                aria-label="Close lightbox"
              >
                <CircleX className="size-6" aria-hidden="true" />
              </Button>
              <Button
                variant="outline"
                type="button"
                className="lightbox__chrome-btn rounded-full bg-foreground text-primary-foreground"
                data-lightbox-zoom
                aria-label="Open photo in new tab"
              >
                <ZoomIn className="size-5" aria-hidden="true" />
              </Button>
            </div>
            <span class="lightbox__counter" data-lightbox-counter aria-live="polite">
              1 / {photos.length}
            </span>
          </div>
          <div class="lightbox__viewport" data-lightbox-viewport>
            <div class="lightbox__track" data-lightbox-track>
              {lightboxManifest.map((entry) => (
                <article class="lightbox__slide" data-lightbox-slide>
                  <div class="lightbox__media" data-lightbox-swipe-zone>
                    <img
                      data-lightbox-img
                      src={entry.src}
                      width={entry.width}
                      height={entry.height}
                      alt={`${entry.title} in ${entry.location}`}
                      loading="eager"
                      decoding="async"
                      draggable="false"
                      data-orientation={entry.orientation}
                      style={entry.aspectRatio ? `--media-aspect: ${entry.aspectRatio}` : undefined}
                    />
                  </div>
                  <div class="lightbox__details bg-secondary text-secondary-foreground shadow-2xl">
                    <div>
                      <p class="lightbox__location text-xs">{entry.location}</p>
                      <h2 class="lightbox__headline text-xl font-bold">{entry.title}</h2>
                    </div>
                    {entry.excerpt && (
                      <p class="lightbox__excerpt text-sm">{entry.excerpt}</p>
                    )}
                    <div class="lightbox__meta">
                      <span class="lightbox__date text-xs">{entry.formattedDate}</span>
                      {entry.tags.length > 0 && (
                        <div class="lightbox__tags">
                          {entry.tags.map((tag) => (
                            <span class="lightbox__tag bg-primary text-primary-foreground">{tag}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <Button
                type="button"
                variant="outline"
                className="lightbox__nav lightbox__nav--prev rounded-full bg-foreground text-primary-foreground"
                data-lightbox-prev
            aria-label="Show previous photo"
              >
            <ArrowLeft className="size-6" aria-hidden="true" />
              </Button>
         
         <Button
                type="button"
                variant="outline"
                className="lightbox__nav lightbox__nav--next rounded-full bg-foreground text-primary-foreground"
                data-lightbox-next
            aria-label="Show next photo"
              >
            <ArrowRight className="size-6" aria-hidden="true" />
              </Button>
         
        </section>
        <script type="module" is:inline>
          (() => {
            const lightbox = document.querySelector("[data-lightbox]");
            if (!lightbox) return;

            const triggers = document.querySelectorAll("[data-photo-idx]");
            const track = lightbox.querySelector("[data-lightbox-track]");
            const viewport = lightbox.querySelector("[data-lightbox-viewport]");
            const counter = lightbox.querySelector("[data-lightbox-counter]");
            const closeButtons = lightbox.querySelectorAll("[data-lightbox-close]");
            const nextButton = lightbox.querySelector("[data-lightbox-next]");
            const prevButton = lightbox.querySelector("[data-lightbox-prev]");
            const backdrop = lightbox.querySelector("[data-lightbox-backdrop]");
            const slides = Array.from(lightbox.querySelectorAll("[data-lightbox-slide]"));
            const total = slides.length;
            const zoomButton = lightbox.querySelector("[data-lightbox-zoom]");

            if (!track || !viewport || total === 0) return;

            let current = 0;
            let lastFocused = null;
            let pointerActive = false;
            let startX = 0;
            let deltaX = 0;

            const lockTargets = [document.documentElement, document.body];

            const setScrollLock = (active) => {
              lockTargets.forEach((node) => {
                if (node) {
                  node.classList.toggle("lightbox-lock", active);
                }
              });
            };

            const updateCounter = () => {
              if (counter) {
                counter.textContent = `${current + 1} / ${total}`;
              }
            };

            const applyTransform = (percent) => {
              if (track) {
                track.style.transform = `translateX(${percent}%)`;
              }
            };

            const snapTo = (index, { animate = true } = {}) => {
              current = (index + total) % total;
              track.style.transition = animate ? "" : "none";
              applyTransform(current * -100);
              if (!animate) {
                requestAnimationFrame(() => {
                  track.style.transition = "";
                });
              }
              updateCounter();
              updateActionButtons();
            };

            const getActiveImageInfo = () => {
              const slide = slides[current];
              if (!slide) return null;
              const img = slide.querySelector("[data-lightbox-img]");
              if (!(img instanceof HTMLImageElement)) return null;
              const rawSrc = img.getAttribute("src");
              if (!rawSrc) return null;
              let absoluteSrc = rawSrc;
              try {
                absoluteSrc = new URL(rawSrc, window.location.origin).href;
              } catch {
                absoluteSrc = rawSrc;
              }
              let fileName = "";
              try {
                const url = new URL(rawSrc, window.location.origin);
                fileName = url.pathname.split("/").pop() ?? "";
              } catch {
                const parts = rawSrc.split("/");
                fileName = parts[parts.length - 1] ?? "";
              }
              if (!fileName || !fileName.includes(".")) {
                fileName = `photo-${current + 1}.jpg`;
              }
              return { src: absoluteSrc, fileName };
            };

            const updateActionButtons = () => {
              const info = getActiveImageInfo();
              const hasAsset = Boolean(info);
              [zoomButton].forEach((btn) => {
                if (!(btn instanceof HTMLButtonElement)) return;
                btn.disabled = !hasAsset;
                btn.setAttribute("aria-disabled", hasAsset ? "false" : "true");
              });
            };

            updateActionButtons();

            const openLightbox = (index) => {
              lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
              lightbox.setAttribute("data-open", "true");
              lightbox.setAttribute("aria-hidden", "false");
              setScrollLock(true);
              snapTo(index, { animate: false });
              const focusTarget = lightbox.querySelector("[data-lightbox-close]");
              if (focusTarget instanceof HTMLElement) {
                focusTarget.focus();
              }
            };

            const closeLightbox = () => {
              lightbox.setAttribute("data-open", "false");
              lightbox.setAttribute("aria-hidden", "true");
              setScrollLock(false);
              if (lastFocused instanceof HTMLElement) {
                lastFocused.focus();
              }
            };

            triggers.forEach((trigger) => {
              trigger.addEventListener("click", () => {
                const index = Number(trigger.getAttribute("data-photo-idx")) || 0;
                openLightbox(index);
              });
              trigger.addEventListener("keydown", (event) => {
                if (event.key === "Enter" || event.key === " ") {
                  event.preventDefault();
                  const index = Number(trigger.getAttribute("data-photo-idx")) || 0;
                  openLightbox(index);
                }
              });
            });

            closeButtons.forEach((btn) => btn.addEventListener("click", closeLightbox));
            if (backdrop) {
              backdrop.addEventListener("click", closeLightbox);
            }
            if (nextButton) {
              nextButton.addEventListener("click", () => snapTo(current + 1));
            }
            if (prevButton) {
              prevButton.addEventListener("click", () => snapTo(current - 1));
            }

            if (zoomButton instanceof HTMLButtonElement) {
              zoomButton.addEventListener("click", () => {
                const info = getActiveImageInfo();
                if (!info) return;
                window.open(info.src, "_blank", "noopener,noreferrer");
              });
            }

            window.addEventListener("keydown", (event) => {
              if (lightbox.getAttribute("data-open") !== "true") return;
              if (event.key === "Escape") {
                event.preventDefault();
                closeLightbox();
              } else if (event.key === "ArrowRight") {
                event.preventDefault();
                snapTo(current + 1);
              } else if (event.key === "ArrowLeft") {
                event.preventDefault();
                snapTo(current - 1);
              }
            });

            const handlePointerDown = (event) => {
              if (event.pointerType === "mouse" && event.button !== 0) return;
              const origin = event.target instanceof HTMLElement
                ? event.target.closest("[data-lightbox-img], [data-lightbox-swipe-zone]")
                : null;
              if (!origin) return;
              event.preventDefault();
              pointerActive = true;
              startX = event.clientX;
              deltaX = 0;
              track.style.transition = "none";
              if (typeof viewport.setPointerCapture === "function") {
                viewport.setPointerCapture(event.pointerId);
              }
            };

            const handlePointerMove = (event) => {
              if (!pointerActive) return;
              deltaX = event.clientX - startX;
              const deltaPercent = viewport.clientWidth ? (deltaX / viewport.clientWidth) * 100 : 0;
              applyTransform((-current * 100) + deltaPercent);
            };

            const handlePointerUp = (event) => {
              if (!pointerActive) return;
              pointerActive = false;
              if (event && typeof viewport.releasePointerCapture === "function") {
                viewport.releasePointerCapture(event.pointerId);
              }
              track.style.transition = "";
              const threshold = viewport.clientWidth ? viewport.clientWidth * 0.15 : 0;
              if (Math.abs(deltaX) > threshold) {
                snapTo(deltaX > 0 ? current - 1 : current + 1);
              } else {
                applyTransform(current * -100);
              }
            };

            viewport.addEventListener("pointerdown", handlePointerDown);
            viewport.addEventListener("pointermove", handlePointerMove);
            viewport.addEventListener("pointerup", handlePointerUp);
            viewport.addEventListener("pointercancel", handlePointerUp);
            viewport.addEventListener("pointerleave", (event) => {
              if (pointerActive) handlePointerUp(event);
            });
          })();
        </script>
      </>
    )}
    <!-- LIGHTBOX -->
  </body>
</Layout>
