---
import "@/styles/lightbox.css"
import Layout from "./layout.astro";
import { getPhotosByCity, groupPhotosByLocation } from "@/lib/photos";
import { getMetadataFromSlug } from "@/lib/metadata";
import { Button } from "@/components/ui/button";
import { CircleX, ArrowLeft, ArrowRight, ZoomIn } from "lucide-react";
import { getAllMetadata } from "@/lib/metadata";
import { formatDate } from "@/lib/utils";

const INITIAL_BATCH_SIZE = 24;
const LOAD_BATCH_SIZE = 24;

export function getStaticPaths() {
  const locations = getAllMetadata();
  const paths = locations.map((loc) => ({ params: { city: loc.city }}));
  return paths;
}

const city = Astro.params.city || "";

// Fetch photos for this location
const photos = await getPhotosByCity(city);

if (photos.length === 0) {
  throw new Response("Not found", { status: 404 });
}

const { country, flag, title: locationLabel, code, count } = getMetadataFromSlug(city);


function excerptFromEntry(entry: any) {
  const raw = (entry?.body ?? "").trim();
  if (!raw) return "";
  const withoutComments = raw.replace(/<!--.*?-->/gs, "");
  const oneLine = withoutComments.replace(/\n+/g, " ");
  const clean = oneLine.replace(/\s+/g, " ").trim();
  const slice = clean.slice(0, 140);
  return slice + (clean.length > 140 ? "…" : "");
}

const serializedPhotos = photos.map((entry, index) => {
  const width = entry.data.image.width;
  const height = entry.data.image.height;
  const aspectRatio = width && height ? `${width} / ${height}` : null;
  let orientation: "portrait" | "landscape" | "square" = "landscape";

  if (width && height) {
    if (width === height) {
      orientation = "square";
    } else {
      orientation = width > height ? "landscape" : "portrait";
    }
  }

  const thumbSrc = entry.data.image.thumbnail?.src ?? entry.data.image.src;

  return {
    index,
    id: entry.data.id,
    fullSrc: entry.data.image.src,
    thumbSrc,
    width,
    height,
    orientation,
    aspectRatio,
    title: entry.data.title,
    tags: entry.data.tags ?? [],
    date: entry.data.date,
    formattedDate: formatDate(entry.data.date),
    excerpt: excerptFromEntry(entry),
    slug: entry.slug,
    location: locationLabel,
  };
});

const totalPhotos = count;
const initialPhotos = serializedPhotos.slice(0, INITIAL_BATCH_SIZE);
const initialCount = initialPhotos.length;
const manifestJson = JSON.stringify(serializedPhotos).replace(/</g, "\\u003c");
---

<Layout title={locationLabel}>
  <body>
    <main class="max-w-6xl mx-auto p-6">
      <!-- HEADER: FLAG + COUNTRY + PHOTOS LIST -->
      <header class="mb-6 flex gap-1">
        {
          flag && (
            <img
              src={flag}
              alt={`${country} flag`}
              class="h-12 w-auto inline-block mr-2 rounded-xs"
              loading="lazy"
            />
          )
        }
        <div>
          <h1 class="text-2xl font-semibold text-left leading-none">
            {locationLabel}
          </h1>
          <p class="text-muted-foreground">
            {totalPhotos}{" "}
            {totalPhotos === 1 ? "photo" : "photos"}
          </p>
        </div>
      </header>
      <!-- TAGS , ACCORDION LIKE -->
      <!-- GALLERY, INFINITE SCROLLING -->
      {
        totalPhotos === 0 ? (
          <p class="text-center">No photos found for this location.</p>
        ) : (
          <>
            <section
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10"
              data-gallery
              data-initial-count={initialCount}
              data-batch-size={LOAD_BATCH_SIZE}
              data-total-count={totalPhotos}
            >
              {initialPhotos.map((photo) => (
                <figure
                  class="group relative rounded-lg overflow-hidden border cursor-zoom-in
                  aspect-square focus-visible:outline-2 focus-visible:outline-offset-2 
                  focus-visible:outline-primary"
                  data-photo-idx={photo.index}
                  tabindex="0"
                  role="button"
                  aria-label={`View ${photo.title} in full size`}
                  aria-haspopup="dialog"
                >
                  <img
                    src={photo.thumbSrc}
                    width={photo.width}
                    height={photo.height}
                    alt={photo.title}
                    class="w-full h-full block object-cover"
                    loading="lazy"
                    decoding="async"
                    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  />
                  <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                    <div class="absolute bottom-0 left-0 right-0 p-4 text-primary-foreground">
                      <h3 class="text-sm font-semibold">{photo.title}</h3>
                      {photo.excerpt && (
                        <p class="text-xs mt-1">{photo.excerpt}</p>
                      )}
                      {photo.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2 mt-2">
                          {photo.tags.map((tag: string) => (
                            <span class="text-xs px-2 py-0.5 rounded-full bg-primary text-primary-foreground">
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                      <div class="text-xs mt-2 opacity-80">
                        {photo.formattedDate}
                      </div>
                    </div>
                  </div>
                </figure>
              ))}
            </section>
            <div
              class="mt-8 flex items-center justify-center gap-2 text-sm text-muted-foreground"
              data-gallery-loader
              hidden
            >
              <span class="inline-flex h-2 w-2 animate-pulse rounded-full bg-muted-foreground"></span>
              Loading more photos…
            </div>
            <div
              class="mt-2 text-center text-xs uppercase tracking-wide text-muted-foreground"
              data-gallery-complete
              hidden
            >
              You've reached the end.
            </div>
            {initialCount < totalPhotos && (
              <div data-gallery-sentinel class="h-1" aria-hidden="true"></div>
            )}
          </>
        )
      }
    </main>
    <script
      type="application/json"
      id="photo-manifest"
      set:html={manifestJson}
    ></script>
    {totalPhotos > 0 && (
      <>
        <section
          class="lightbox"
          data-lightbox
          data-open="false"
          aria-hidden="true"
          aria-label={`Expanded photo viewer for ${locationLabel}`}
          aria-modal="true"
          role="dialog"
        >
          <div class="lightbox__backdrop" data-lightbox-backdrop aria-hidden="true"></div>
          <div class="lightbox__chrome">
            <div class="lightbox__chrome-group">              
              <Button
                type="button"
                variant="outline"
                className="lightbox__chrome-btn rounded-full bg-foreground text-primary-foreground"
                data-lightbox-close
                aria-label="Close lightbox"
              >
                <CircleX className="size-6" aria-hidden="true" />
              </Button>
              <Button
                variant="outline"
                type="button"
                className="lightbox__chrome-btn rounded-full bg-foreground text-primary-foreground"
                data-lightbox-zoom
                aria-label="Open photo in new tab"
              >
                <ZoomIn className="size-5" aria-hidden="true" />
              </Button>
            </div>
            <span class="lightbox__counter" data-lightbox-counter aria-live="polite">
              1 / {totalPhotos}
            </span>
          </div>
          <div class="lightbox__viewport" data-lightbox-viewport>
            <div class="lightbox__track" data-lightbox-track></div>
          </div>
          <Button
                type="button"
                variant="outline"
                className="lightbox__nav lightbox__nav--prev rounded-full bg-foreground text-primary-foreground"
                data-lightbox-prev
            aria-label="Show previous photo"
              >
            <ArrowLeft className="size-6" aria-hidden="true" />
              </Button>
         
         <Button
                type="button"
                variant="outline"
                className="lightbox__nav lightbox__nav--next rounded-full bg-foreground text-primary-foreground"
                data-lightbox-next
            aria-label="Show next photo"
              >
            <ArrowRight className="size-6" aria-hidden="true" />
              </Button>
         
        </section>
        <script type="module" is:inline>
          (() => {
            const manifestEl = document.getElementById("photo-manifest");
            if (!manifestEl) return;
            let photos = [];
            try {
              photos = JSON.parse(manifestEl.textContent || "[]");
            } catch {
              photos = [];
            }
            if (!Array.isArray(photos)) {
              photos = [];
            }
            const openLightbox = initLightbox(photos);
            initGallery(photos, openLightbox);
          })();

          function initGallery(photos, openLightbox) {
            const gallery = document.querySelector("[data-gallery]");
            if (!gallery) return;
            const sentinel = document.querySelector("[data-gallery-sentinel]");
            const loader = document.querySelector("[data-gallery-loader]");
            const complete = document.querySelector("[data-gallery-complete]");
            const batchSize = Number(gallery.dataset.batchSize) || 12;
            let loaded = Number(gallery.dataset.initialCount) || 0;
            let loadingMore = false;
            const total = Array.isArray(photos) ? photos.length : 0;
            let observer;

            const handleTrigger = (event) => {
              const target = event.target instanceof HTMLElement
                ? event.target.closest("[data-photo-idx]")
                : null;
              if (!target) return;
              const isClick = event.type === "click";
              const isKey = event.type === "keydown" && (event.key === "Enter" || event.key === " ");
              if (!isClick && !isKey) return;
              event.preventDefault();
              const idx = Number(target.getAttribute("data-photo-idx")) || 0;
              if (typeof openLightbox === "function") {
                openLightbox(idx);
              }
            };

            gallery.addEventListener("click", handleTrigger);
            gallery.addEventListener("keydown", handleTrigger);

            const appendPhotos = (start, end) => {
              if (!Array.isArray(photos) || start >= end) return 0;
              const fragment = document.createDocumentFragment();
              const slice = photos.slice(start, end);
              slice.forEach((photo) => {
                fragment.appendChild(createFigure(photo));
              });
              gallery.appendChild(fragment);
              return slice.length;
            };

            const loadMore = () => {
              if (loadingMore || loaded >= total) return;
              loadingMore = true;
              loader?.removeAttribute("hidden");
              const nextEnd = Math.min(total, loaded + batchSize);
              const added = appendPhotos(loaded, nextEnd);
              loaded += added;
              loader?.setAttribute("hidden", "true");
              loadingMore = false;
              if (loaded >= total) {
                complete?.removeAttribute("hidden");
                if (sentinel) {
                  sentinel.setAttribute("hidden", "true");
                }
                observer?.disconnect();
              }
            };

            if (sentinel && loaded < total) {
              observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                  loadMore();
                }
              }, { rootMargin: "400px 0px" });
              observer.observe(sentinel);
            }

            function createFigure(photo) {
              if (!photo) {
                return document.createComment("missing-photo");
              }
              const figure = document.createElement("figure");
              figure.className =
                "group relative rounded-lg overflow-hidden border cursor-zoom-in aspect-square focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary";
              figure.tabIndex = 0;
              figure.dataset.photoIdx = String(photo.index ?? 0);
              figure.setAttribute("role", "button");
              figure.setAttribute("aria-label", `View ${photo.title ?? "photo"} in full size`);
              figure.setAttribute("aria-haspopup", "dialog");

              const img = document.createElement("img");
              img.src = photo.thumbSrc || photo.fullSrc || "";
              img.alt = photo.title ?? "";
              img.loading = "lazy";
              img.decoding = "async";
              if (photo.width) img.width = photo.width;
              if (photo.height) img.height = photo.height;
              img.sizes = "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";
              img.className = "w-full h-full block object-cover";
              figure.appendChild(img);

              const overlay = document.createElement("div");
              overlay.className =
                "absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-200";
              const inner = document.createElement("div");
              inner.className = "absolute bottom-0 left-0 right-0 p-4 text-primary-foreground";

              const title = document.createElement("h3");
              title.className = "text-sm font-semibold";
              title.textContent = photo.title ?? "";
              inner.appendChild(title);

              if (photo.excerpt) {
                const excerpt = document.createElement("p");
                excerpt.className = "text-xs mt-1";
                excerpt.textContent = photo.excerpt;
                inner.appendChild(excerpt);
              }

              if (Array.isArray(photo.tags) && photo.tags.length > 0) {
                const tagsWrap = document.createElement("div");
                tagsWrap.className = "flex flex-wrap gap-2 mt-2";
                photo.tags.forEach((tag) => {
                  const chip = document.createElement("span");
                  chip.className = "text-xs px-2 py-0.5 rounded-full bg-primary text-primary-foreground";
                  chip.textContent = tag;
                  tagsWrap.appendChild(chip);
                });
                inner.appendChild(tagsWrap);
              }

              const date = document.createElement("div");
              date.className = "text-xs mt-2 opacity-80";
              date.textContent = photo.formattedDate ?? "";
              inner.appendChild(date);

              overlay.appendChild(inner);
              figure.appendChild(overlay);

              return figure;
            }
          }

          function initLightbox(photos) {
            const lightbox = document.querySelector("[data-lightbox]");
            if (!lightbox || !Array.isArray(photos) || photos.length === 0) {
              return null;
            }

            const track = lightbox.querySelector("[data-lightbox-track]");
            const viewport = lightbox.querySelector("[data-lightbox-viewport]");
            const counter = lightbox.querySelector("[data-lightbox-counter]");
            const closeButtons = lightbox.querySelectorAll("[data-lightbox-close]");
            const nextButton = lightbox.querySelector("[data-lightbox-next]");
            const prevButton = lightbox.querySelector("[data-lightbox-prev]");
            const backdrop = lightbox.querySelector("[data-lightbox-backdrop]");
            const zoomButton = lightbox.querySelector("[data-lightbox-zoom]");

            if (!track || !viewport) {
              return null;
            }

            let lastFocused = null;
            let pointerActive = false;
            let startX = 0;
            let deltaX = 0;

            const state = {
              total: photos.length,
              index: 0,
              virtualized: photos.length > 3,
              slides: [],
              staticSlidesHydrated: false,
              isTransitioning: false,
            };

            const lockTargets = [document.documentElement, document.body];
            const slidesToCreate = state.virtualized ? 3 : state.total;
            for (let i = 0; i < slidesToCreate; i++) {
              const slideRef = createSlide();
              state.slides.push(slideRef);
              track.appendChild(slideRef.el);
            }

            setCurrentIndex(0, { immediate: true });

            closeButtons.forEach((btn) => btn.addEventListener("click", closeLightbox));
            backdrop?.addEventListener("click", closeLightbox);
            nextButton?.addEventListener("click", () => animateStep(1));
            prevButton?.addEventListener("click", () => animateStep(-1));

            if (zoomButton instanceof HTMLButtonElement) {
              zoomButton.addEventListener("click", () => {
                const active = getActivePhoto();
                if (!active?.fullSrc) return;
                window.open(active.fullSrc, "_blank", "noopener,noreferrer");
              });
            }

            window.addEventListener("keydown", (event) => {
              if (lightbox.getAttribute("data-open") !== "true") return;
              if (event.key === "Escape") {
                event.preventDefault();
                closeLightbox();
              } else if (event.key === "ArrowRight") {
                event.preventDefault();
                animateStep(1);
              } else if (event.key === "ArrowLeft") {
                event.preventDefault();
                animateStep(-1);
              }
            });

            viewport.addEventListener("pointerdown", handlePointerDown);
            viewport.addEventListener("pointermove", handlePointerMove);
            viewport.addEventListener("pointerup", handlePointerUp);
            viewport.addEventListener("pointercancel", handlePointerUp);
            viewport.addEventListener("pointerleave", (event) => {
              if (pointerActive) handlePointerUp(event);
            });

            return openLightbox;

            function openLightbox(index) {
              lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
              lightbox.setAttribute("data-open", "true");
              lightbox.setAttribute("aria-hidden", "false");
              setScrollLock(true);
              setCurrentIndex(index, { immediate: true });
              const focusTarget = lightbox.querySelector("[data-lightbox-close]");
              if (focusTarget instanceof HTMLElement) {
                focusTarget.focus();
              }
            }

            function closeLightbox() {
              lightbox.setAttribute("data-open", "false");
              lightbox.setAttribute("aria-hidden", "true");
              setScrollLock(false);
              if (lastFocused instanceof HTMLElement) {
                lastFocused.focus();
              }
            }

            function setScrollLock(active) {
              lockTargets.forEach((node) => {
                if (node) {
                  node.classList.toggle("lightbox-lock", active);
                }
              });
            }

            function getActivePhoto() {
              return photos[state.index] ?? null;
            }

            function updateCounter() {
              if (!counter) return;
              counter.textContent = `${state.total ? state.index + 1 : 0} / ${state.total}`;
            }

            function updateActionButtons() {
              const disableNav = state.total <= 1;
              [nextButton, prevButton].forEach((btn) => {
                if (!(btn instanceof HTMLButtonElement)) return;
                btn.disabled = disableNav;
                btn.setAttribute("aria-disabled", disableNav ? "true" : "false");
              });
              if (zoomButton instanceof HTMLButtonElement) {
                const hasAsset = Boolean(getActivePhoto()?.fullSrc);
                zoomButton.disabled = !hasAsset;
                zoomButton.setAttribute("aria-disabled", hasAsset ? "false" : "true");
              }
            }

            function setTrackPosition(percent, { animate = true } = {}) {
              if (!track) return;
              if (animate) {
                track.style.transition = "";
                track.style.transform = `translateX(${percent}%)`;
                return;
              }
              track.style.transition = "none";
              track.style.transform = `translateX(${percent}%)`;
              requestAnimationFrame(() => {
                track.style.transition = "";
              });
            }

            function mod(value) {
              if (!state.total) return 0;
              const remainder = value % state.total;
              return remainder < 0 ? remainder + state.total : remainder;
            }

            function setCurrentIndex(targetIndex, { immediate = false } = {}) {
              if (!state.total) return;
              state.index = mod(targetIndex);
              if (state.virtualized) {
                const prevIndex = mod(state.index - 1);
                const nextIndex = mod(state.index + 1);
                updateSlide(state.slides[0], photos[prevIndex]);
                updateSlide(state.slides[1], photos[state.index]);
                updateSlide(state.slides[2], photos[nextIndex]);
                setTrackPosition(-100, { animate: !immediate });
              } else {
                hydrateStaticSlides();
                setTrackPosition(-state.index * 100, { animate: !immediate });
              }
              updateCounter();
              updateActionButtons();
            }

            function animateStep(direction) {
              if (state.total <= 1) return;
              if (state.virtualized) {
                if (state.isTransitioning) return;
                state.isTransitioning = true;
                setTrackPosition(direction === 1 ? -200 : 0, { animate: true });
                const handle = () => {
                  track.removeEventListener("transitionend", handle);
                  setCurrentIndex(state.index + direction, { immediate: true });
                  setTrackPosition(-100, { animate: false });
                  state.isTransitioning = false;
                };
                track.addEventListener("transitionend", handle, { once: true });
              } else {
                setCurrentIndex(state.index + direction);
              }
            }

            function hydrateStaticSlides() {
              if (state.staticSlidesHydrated) return;
              state.slides.forEach((slideRef, idx) => {
                updateSlide(slideRef, photos[idx]);
              });
              state.staticSlidesHydrated = true;
            }

            function createSlide() {
              const article = document.createElement("article");
              article.className = "lightbox__slide";
              article.setAttribute("data-lightbox-slide", "");

              const media = document.createElement("div");
              media.className = "lightbox__media";
              media.setAttribute("data-lightbox-swipe-zone", "");
              const img = document.createElement("img");
              img.setAttribute("data-lightbox-img", "");
              img.loading = "lazy";
              img.decoding = "async";
              img.draggable = false;
              media.appendChild(img);

              const details = document.createElement("div");
              details.className = "lightbox__details bg-secondary text-secondary-foreground shadow-2xl";
              const header = document.createElement("div");
              const location = document.createElement("p");
              location.className = "lightbox__location text-xs";
              const title = document.createElement("h2");
              title.className = "lightbox__headline text-xl font-bold";
              header.append(location, title);

              const excerpt = document.createElement("p");
              excerpt.className = "lightbox__excerpt text-sm";
              excerpt.hidden = true;

              const meta = document.createElement("div");
              meta.className = "lightbox__meta";
              const date = document.createElement("span");
              date.className = "lightbox__date text-xs";
              const tags = document.createElement("div");
              tags.className = "lightbox__tags";
              meta.append(date, tags);

              details.append(header, excerpt, meta);
              article.append(media, details);

              return { el: article, img, location, title, excerpt, date, tags };
            }

            function updateSlide(slideRef, photo) {
              if (!slideRef || !photo) return;
              slideRef.el.dataset.photoIdx = String(photo.index ?? 0);
              slideRef.img.src = photo.fullSrc || photo.thumbSrc || "";
              slideRef.img.alt = `${photo.title ?? "Photo"}${photo.location ? ` in ${photo.location}` : ""}`;
              slideRef.img.dataset.orientation = photo.orientation ?? "landscape";
              if (photo.aspectRatio) {
                slideRef.img.style.setProperty("--media-aspect", photo.aspectRatio);
              } else {
                slideRef.img.style.removeProperty("--media-aspect");
              }
              slideRef.location.textContent = photo.location ?? "";
              slideRef.title.textContent = photo.title ?? "";
              if (photo.excerpt) {
                slideRef.excerpt.textContent = photo.excerpt;
                slideRef.excerpt.hidden = false;
              } else {
                slideRef.excerpt.textContent = "";
                slideRef.excerpt.hidden = true;
              }
              slideRef.date.textContent = photo.formattedDate ?? "";
              slideRef.tags.innerHTML = "";
              if (Array.isArray(photo.tags) && photo.tags.length > 0) {
                slideRef.tags.hidden = false;
                photo.tags.forEach((tag) => {
                  const chip = document.createElement("span");
                  chip.className = "lightbox__tag bg-primary text-primary-foreground";
                  chip.textContent = tag;
                  slideRef.tags.appendChild(chip);
                });
              } else {
                slideRef.tags.hidden = true;
              }
            }

            function handlePointerDown(event) {
              if (event.pointerType === "mouse" && event.button !== 0) return;
              const origin = event.target instanceof HTMLElement
                ? event.target.closest("[data-lightbox-img], [data-lightbox-swipe-zone]")
                : null;
              if (!origin) return;
              event.preventDefault();
              pointerActive = true;
              startX = event.clientX;
              deltaX = 0;
              track.style.transition = "none";
              viewport.setPointerCapture?.(event.pointerId);
            }

            function handlePointerMove(event) {
              if (!pointerActive) return;
              deltaX = event.clientX - startX;
              const width = viewport.clientWidth || 1;
              const deltaPercent = (deltaX / width) * 100;
              const base = state.virtualized ? -100 : -state.index * 100;
              setTrackPosition(base + deltaPercent, { animate: false });
            }

            function handlePointerUp(event) {
              if (!pointerActive) return;
              pointerActive = false;
              viewport.releasePointerCapture?.(event.pointerId);
              const threshold = (viewport.clientWidth || 1) * 0.15;
              if (Math.abs(deltaX) > threshold) {
                animateStep(deltaX > 0 ? -1 : 1);
              } else {
                const base = state.virtualized ? -100 : -state.index * 100;
                setTrackPosition(base, { animate: true });
              }
            }
          }
        </script>
      </>
    )}
    <!-- LIGHTBOX -->
  </body>
</Layout>
