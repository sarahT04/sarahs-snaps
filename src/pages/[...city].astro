---
import "@/styles/lightbox.css"
import Layout from "./layout.astro";
import { getCollection } from "astro:content";
import { getPhotosByCity, groupPhotosByLocation } from "@/lib/photos";
import { getCountryFlag } from "@/lib/photos";
import { getLocationFromSlug } from "@/lib/slug";
import { Button } from "@/components/ui/button";
import { CircleX, ArrowLeftCircle, ArrowRightCircle } from "lucide-react";

export async function getStaticPaths() {
  const photos = await getCollection("photos");
  const locations = groupPhotosByLocation(photos);

  // Generate both city-only and country/city paths for flexibility
  const paths = locations.flatMap((loc) => [
    { params: { city: loc.city } },
    { params: { city: `${loc.country}/${loc.city}` } }, 
  ]);

  return paths;
}

const raw = Astro.params.city || "";
const segments = raw.split("/").filter(Boolean);
// Support both "/rome" and "/italy/rome" style routes
const city = segments.at(-1) ?? "";
const country = segments.length > 1 ? segments[0] : undefined;

// Fetch photos for this location
const photos = await getPhotosByCity(city, country);

// Derive country when not present in the route, then build metadata (including flag)
const derivedCountry =
  country ??
  (photos[0] ? getLocationFromSlug(photos[0].slug).country : undefined);
const flagUrl = derivedCountry ? getCountryFlag(derivedCountry) : null;
const metadata = { country: derivedCountry, flag: flagUrl };
const prettyCity = city
  .split("-")
  .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
  .join(" ");
const prettyCountry = derivedCountry
  ? derivedCountry
      .split("-")
      .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
      .join(" ")
  : undefined;
const locationLabel = prettyCountry ? `${prettyCity}, ${prettyCountry}` : prettyCity;

function formatDate(dateStr: string) {
  try {
    return new Date(dateStr).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "2-digit",
    });
  } catch {
    return dateStr;
  }
}

function excerptFromEntry(entry: any) {
  const raw = (entry?.body ?? "").trim();
  if (!raw) return "";
  const withoutComments = raw.replace(/<!--.*?-->/gs, "");
  const oneLine = withoutComments.replace(/\n+/g, " ");
  const clean = oneLine.replace(/\s+/g, " ").trim();
  const slice = clean.slice(0, 140);
  return slice + (clean.length > 140 ? "…" : "");
}

const lightboxManifest = photos.map((entry, index) => ({
  index,
  id: entry.data.id,
  src: entry.data.image.src,
  width: entry.data.image.width,
  height: entry.data.image.height,
  title: entry.data.title,
  tags: entry.data.tags ?? [],
  date: entry.data.date,
  formattedDate: formatDate(entry.data.date),
  excerpt: excerptFromEntry(entry),
  slug: entry.slug,
  location: locationLabel,
}));
---

<Layout title={locationLabel}>
  <body>
    <main class="max-w-6xl mx-auto p-6">
      <!-- HEADER: FLAG + COUNTRY + PHOTOS LIST -->
      <header class="mb-6 flex gap-1">
        {
          metadata.flag && (
            <img
              src={metadata.flag}
              alt={`${prettyCountry ?? prettyCity} flag`}
              class="h-12 w-auto inline-block mr-2 rounded-xs"
              loading="lazy"
            />
          )
        }
        <div>
          <h1 class="text-2xl font-semibold text-left leading-none">
            {prettyCity}{prettyCountry ? `, ${prettyCountry}` : ""}
          </h1>
          <p class="text-muted-foreground">
            {photos.length}
            {photos.length === 1 ? "photo" : "photos"}
          </p>
        </div>
      </header>
      <!-- GALLERY -->
      {
        photos.length === 0 ? (
          <p class="text-center">No photos found for this location.</p>
        ) : (
          <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
            {photos.map((p, i) => (
              <figure
                class="group relative rounded-lg overflow-hidden border cursor-zoom-in
                aspect-square focus-visible:outline-2 focus-visible:outline-offset-2 
                focus-visible:outline-primary"
                data-photo-idx={i}
                tabindex="0"
                role="button"
                aria-label={`View ${p.data.title} in full size`}
                aria-haspopup="dialog"
              >
                <img
                  src={p.data.image.src}
                  width={p.data.image.width}
                  height={p.data.image.height}
                  alt={p.data.title}
                  class="w-full h-full block object-cover"
                  loading="lazy"
                />
                {/* on hover will show picture details */}
                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                  <div class="absolute bottom-0 left-0 right-0 p-4 text-primary-foreground">
                    <h3 class="text-sm font-semibold">{p.data.title}</h3>
                    {excerptFromEntry(p) && (
                      <p class="text-xs mt-1">{excerptFromEntry(p)}</p>
                    )}
                    <div class="flex flex-wrap gap-2 mt-2">
                      {p.data.tags.map((tag: string) => (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-primary text-primary-foreground">
                          {tag}
                        </span>
                      ))}
                    </div>
                    <div class="text-xs mt-2 opacity-80">
                      {formatDate(p.data.date)}
                    </div>
                  </div>
                </div>
              </figure>
            ))}
          </section>
        )
      }
    </main>
    <!-- LIGHTBOX -->
    {photos.length > 0 && (
      <div
        class="city-lightbox"
        data-lightbox
        data-open="false"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        hidden
      >
        <div class="lightbox-bg" aria-hidden="true">
          <div class="lightbox-bg-panel" data-lightbox-bg-prev></div>
          <div class="lightbox-bg-panel" data-lightbox-bg-next></div>
        </div>
        <Button variant="outline" data-lightbox-close aria-label="Close viewer"
        className="absolute md:top-6 md:right-6 top-3 right-3 z-20 border-rounded bg-primary">
          <CircleX />
        </Button>
        <div class="lightbox-stage">
          <figure class="lightbox-figure group">
            <div class="lightbox-image-shell">
              <img
                data-lightbox-main
                alt=""
                loading="eager"
                decoding="async"
              />
              <div class="lightbox-info-overlay" aria-hidden="true">
                <div class="lightbox-info-body">
                  <div class="lightbox-info-heading">
                    <h2 data-lightbox-title></h2>
                    <time data-lightbox-date></time>
                    <p data-lightbox-location class="lightbox-location">{locationLabel}</p>
                  </div>
                  <p class="lightbox-info-excerpt" data-lightbox-excerpt></p>
                  <div class="lightbox-tags" data-lightbox-tags></div>
                </div>
              </div>
            </div>
          </figure>
          <div class="lightbox-nav-controls" aria-label="Lightbox navigation">
            <Button
              variant="outline"
              aria-label="View previous photo"
              data-lightbox-prev
              className="lightbox-nav lightbox-nav-prev"
              type="button"
            >
              <ArrowLeftCircle />
            </Button>
            <Button
              variant="outline"
              aria-label="View next photo"
              data-lightbox-next
              className="lightbox-nav lightbox-nav-next"
              type="button"
            >
              <ArrowRightCircle />
            </Button>
          </div>
        </div>
        <div class="sr-only" aria-live="polite" data-lightbox-announcer></div>
      </div>
    )}
    {photos.length > 0 && (
      <script
        type="application/json"
        id="city-photo-payload"
        set:html={JSON.stringify(lightboxManifest)}
      ></script>
    )}
    {photos.length > 0 && (
      <script is:inline>
          (() => {
            let defaultLocation = "";
          const payloadEl = document.getElementById("city-photo-payload");
          if (!payloadEl) return;
          const payloadText = payloadEl.textContent;
          if (!payloadText) return;
          let photoData;
          try {
            photoData = JSON.parse(payloadText);
          } catch {
            photoData = [];
          }
          if (!photoData.length) return;
          defaultLocation = photoData[0]?.location || "";

          const lightbox = document.querySelector("[data-lightbox]");
          if (!lightbox) return;
          const mainImg = lightbox.querySelector("[data-lightbox-main]");
          const imageShell = lightbox.querySelector(".lightbox-image-shell");
          const figureEl = lightbox.querySelector(".lightbox-figure");
          const prevBg = lightbox.querySelector("[data-lightbox-bg-prev]");
          const nextBg = lightbox.querySelector("[data-lightbox-bg-next]");
          const prevBtn = lightbox.querySelector("[data-lightbox-prev]");
          const nextBtn = lightbox.querySelector("[data-lightbox-next]");
          const closeBtn = lightbox.querySelector("[data-lightbox-close]");
          const titleEl = lightbox.querySelector("[data-lightbox-title]");
          const dateEl = lightbox.querySelector("[data-lightbox-date]");
          const excerptEl = lightbox.querySelector("[data-lightbox-excerpt]");
          const locationEl = lightbox.querySelector("[data-lightbox-location]");
          const tagsEl = lightbox.querySelector("[data-lightbox-tags]");
          const announcer = lightbox.querySelector("[data-lightbox-announcer]");
          const stage = lightbox.querySelector(".lightbox-stage");
          const figures = Array.from(document.querySelectorAll("[data-photo-idx]"));
          const docEl = document.documentElement;
          const coarsePointerQuery = window.matchMedia ? window.matchMedia("(pointer: coarse)") : null;
          if (!mainImg || !stage) return;

          let currentIndex = 0;
          let previousOverflow = "";
          const preloadCache = new Set();
          const total = photoData.length;
          const navDisabled = total <= 1;
          let infoVisible = false;
          let pointerSession = null;

          if (navDisabled) {
            if (prevBtn) prevBtn.setAttribute("disabled", "true");
            if (nextBtn) nextBtn.setAttribute("disabled", "true");
          }

          if (imageShell) {
            imageShell.addEventListener("pointerdown", (event) => {
              const coarsePointer = isCoarsePointer(event);
              if (coarsePointer) {
                try {
                  imageShell.setPointerCapture(event.pointerId);
                } catch {}
              }
              pointerSession = {
                id: event.pointerId,
                startX: event.clientX,
                startY: event.clientY,
                startTime: Date.now(),
                isCoarse: coarsePointer,
                swipeIntent: false,
              };
            });

            imageShell.addEventListener("pointermove", (event) => {
              if (!pointerSession || event.pointerId !== pointerSession.id) return;
              const deltaX = event.clientX - pointerSession.startX;
              const deltaY = event.clientY - pointerSession.startY;
              if (
                Math.abs(deltaX) > 18 &&
                Math.abs(deltaX) > Math.abs(deltaY) * 1.25
              ) {
                pointerSession.swipeIntent = true;
                event.preventDefault();
              }
            });

            imageShell.addEventListener("pointerup", (event) => {
              if (!pointerSession || event.pointerId !== pointerSession.id) return;
              const session = pointerSession;
              pointerSession = null;
              try {
                imageShell.releasePointerCapture(event.pointerId);
              } catch {}
              const deltaX = event.clientX - session.startX;
              const deltaY = event.clientY - session.startY;
              const duration = Date.now() - session.startTime;
              const isSwipe =
                session.isCoarse &&
                duration < 700 &&
                Math.abs(deltaX) > 55 &&
                Math.abs(deltaX) > Math.abs(deltaY) * 1.2;
              if (isSwipe) {
                if (navDisabled) return;
                currentIndex = (currentIndex + (deltaX < 0 ? 1 : -1) + total) % total;
                updateLightbox();
                return;
              }
              if (session.isCoarse && !session.swipeIntent) {
                event.preventDefault();
                toggleInfoVisibility();
              }
            });

            imageShell.addEventListener("pointercancel", (event) => {
              if (!pointerSession || event.pointerId !== pointerSession.id) return;
              pointerSession = null;
              try {
                imageShell.releasePointerCapture(event.pointerId);
              } catch {}
            });
          }

          if (figureEl) {
            figureEl.addEventListener("keydown", (event) => {
              if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                toggleInfoVisibility();
              }
            });
          }

          figures.forEach((figure) => {
            const idx = Number(figure.getAttribute("data-photo-idx"));
            figure.addEventListener("click", () => {
              if (Number.isNaN(idx)) return;
              openLightbox(idx);
            });
            figure.addEventListener("keydown", (event) => {
              if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                if (Number.isNaN(idx)) return;
                openLightbox(idx);
              }
            });
          });

          function openLightbox(targetIndex) {
            if (!photoData[targetIndex]) return;
            currentIndex = targetIndex;
            updateLightbox();
            lightbox.hidden = false;
            requestAnimationFrame(() => {
              lightbox.dataset.open = "true";
              lightbox.setAttribute("aria-hidden", "false");
            });
            previousOverflow = docEl.style.overflow;
            docEl.style.overflow = "hidden";
            if (closeBtn) closeBtn.focus({ preventScroll: true });
          }

          function closeLightbox() {
            lightbox.dataset.open = "false";
            lightbox.setAttribute("aria-hidden", "true");
            docEl.style.overflow = previousOverflow;
            resetInfoVisibility();
          }

          function updateLightbox() {
            resetInfoVisibility();
            const current = photoData[currentIndex];
            if (!current) return;
            mainImg.src = current.src;
            mainImg.alt = current.title || "Photo";
            preload(current.src);
            if (current.width) {
              mainImg.width = current.width;
            } else {
              mainImg.removeAttribute("width");
            }
            if (current.height) {
              mainImg.height = current.height;
            } else {
              mainImg.removeAttribute("height");
            }
            if (imageShell) {
              const numericWidth = Math.max(Number(current.width) || 0, 1);
              const numericHeight = Math.max(Number(current.height) || 0, 1);
              imageShell.style.setProperty("--image-aspect", `${numericWidth} / ${numericHeight}`);
              imageShell.dataset.orientation =
                numericWidth / numericHeight >= 2.2
                  ? "panorama"
                  : numericWidth >= numericHeight
                    ? "landscape"
                    : "portrait";
            }
            if (titleEl) titleEl.textContent = current.title || "Untitled";
            if (dateEl) dateEl.textContent = current.formattedDate || current.date || "";
            if (locationEl) locationEl.textContent = current.location || defaultLocation;
            if (excerptEl) {
              excerptEl.textContent = current.excerpt || "";
              excerptEl.classList.toggle("is-empty", !current.excerpt);
            }
            if (tagsEl) {
              tagsEl.innerHTML = "";
              (current.tags || []).forEach((tag) => {
                const badge = document.createElement("span");
                badge.textContent = tag;
                badge.className = "text-xs px-2 py-0.5 rounded-full bg-primary text-primary-foreground mt-2";
                tagsEl.appendChild(badge);
              });
              tagsEl.classList.toggle("has-tags", Boolean((current.tags || []).length));
            }
            const context = getContextPhotos();
            updateBackdrop(context.prev, context.next);
            announce(`${current.title || "Photo"} — ${currentIndex + 1} of ${total}`);
          }

          function getContextPhotos() {
            if (!photoData.length) {
              return { prev: null, next: null };
            }
            if (total === 1) {
              return { prev: null, next: null };
            }
            const prev = photoData[(currentIndex - 1 + total) % total];
            const next = photoData[(currentIndex + 1) % total];
            return { prev, next };
          }

          function updateBackdrop(prev, next) {
            if (prevBg) {
              if (prev) {
                prevBg.style.backgroundImage = `url(${prev.src})`;
                preload(prev.src);
              } else {
                prevBg.style.backgroundImage = "";
              }
            }
            if (nextBg) {
              if (next) {
                nextBg.style.backgroundImage = `url(${next.src})`;
                preload(next.src);
              } else {
                nextBg.style.backgroundImage = "";
              }
            }
          }

          function preload(src) {
            if (!src || preloadCache.has(src)) return;
            const img = new Image();
            img.src = src;
            preloadCache.add(src);
          }

          if (prevBtn) {
            prevBtn.addEventListener("click", () => {
              if (navDisabled) return;
              currentIndex = (currentIndex - 1 + total) % total;
              updateLightbox();
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener("click", () => {
              if (navDisabled) return;
              currentIndex = (currentIndex + 1) % total;
              updateLightbox();
            });
          }

          if (closeBtn) closeBtn.addEventListener("click", closeLightbox);

          lightbox.addEventListener("transitionend", (event) => {
            if (event.target !== lightbox || lightbox.dataset.open === "true") return;
            lightbox.hidden = true;
          });

          lightbox.addEventListener("pointerup", (event) => {
            const target = event.target;
            if (target instanceof Node && stage.contains(target)) return;
            closeLightbox();
          });

          document.addEventListener("keydown", (event) => {
            if (lightbox.dataset.open !== "true") return;
            if (event.key === "Escape") {
              event.preventDefault();
              closeLightbox();
            } else if (event.key === "ArrowRight" && !navDisabled) {
              event.preventDefault();
              currentIndex = (currentIndex + 1) % total;
              updateLightbox();
            } else if (event.key === "ArrowLeft" && !navDisabled) {
              event.preventDefault();
              currentIndex = (currentIndex - 1 + total) % total;
              updateLightbox();
            }
          });

          function announce(message) {
            if (!announcer) return;
            announcer.textContent = "";
            requestAnimationFrame(() => {
              announcer.textContent = message;
            });
          }

          function isCoarsePointer(event) {
            if (event.pointerType === "touch" || event.pointerType === "pen") {
              return true;
            }
            if (!event.pointerType && coarsePointerQuery) {
              return coarsePointerQuery.matches;
            }
            return false;
          }

          function toggleInfoVisibility() {
            setInfoVisibility(!infoVisible);
          }

          function resetInfoVisibility() {
            setInfoVisibility(false);
          }

          function setInfoVisibility(nextState) {
            infoVisible = nextState;
            if (!figureEl) return;
            if (infoVisible) {
              figureEl.dataset.infoOpen = "true";
            } else {
              delete figureEl.dataset.infoOpen;
            }
          }
        })();
      </script>
    )}
  </body>
</Layout>
