---
import Layout from "./layout.astro";
import { Button } from "@/components/ui/button";
import { BookSearch, MapPin } from "lucide-react";

import { getAllMetadata } from "@/lib/metadata";

const locations = getAllMetadata();
---

<Layout>
  <!-- Header -->
  <header class="flex flex-col items-center gap-3">
    <img
      src="./sarah pfp.jpg"
      class="h-44 w-44 rounded-md text-center"
      alt="A picture of Sarah from the back"
    />
    <h1>Sarah's Snaps</h1>
    <p class="lead">Frames of interesting visuals I find</p>
    <!-- Statistics Part -->
    <!-- Random picture button -->
    <!-- <Button -->
    <Button className="mt-2 cursor-pointer" variant="default"
      ><BookSearch /> Show me a random picture!
    </Button>
  </header>
  <body>
    <!-- Cities gallery/pick -->
    <section
      class="grid grid-cols-1 gap-6 p-6 transition-all sm:grid-cols-2 lg:px-48 xl:px-96 sm:py-16"
    >
      {
        locations.map((loc) => (
          <a
            href={`/${loc.city}`}
            class="rounded-xl border p-6 shadow-md backdrop-blur-sm transition hover:shadow-xl"
          >
            <div class="mb-3 flex items-start justify-between">
              <img
                src={loc.flag}
                class="rounded-xs"
                height="40"
                width="40"
                alt={`${loc.country}'s Flag'`}
              />
              <div class="border-primary bg-primary text-primary-foreground rounded-full border px-3 py-1 text-sm font-medium">
                {loc.count} {loc.count === 1 ? "photo" : "photos"}
              </div>
            </div>

            <div class="text-foreground flex items-center">
              <MapPin className="mr-1 h-4 w-4" />
              <h2 class="text-md ml-1 font-semibold capitalize lg:text-xl">
                {loc.city}, {loc.country}
              </h2>
            </div>
          </a>
        ))
      }
    </section>
  </body>
</Layout>
