# ImageKit Configuration
# Get these from: https://imagekit.io/dashboard/developer/api-keys

# Public key (safe to expose in client-side code)
PUBLIC_IMAGEKIT_PUBLIC_KEY=your_public_key_here
PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Private key (NEVER expose to client-side code)
IMAGEKIT_PRIVATE_KEY=your_private_key_here

# GitHub commit target for generated MDX files
GITHUB_TOKEN=github_pat_xxx
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_BRANCH=main

# Authentication (Better Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=your_secret_here
PUBLIC_BETTER_AUTH_BASE_URL=http://localhost:4321
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
ADMIN_EMAIL=your_admin_email_here
